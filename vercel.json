{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "cd apps/frontend && bun install && bun run build.ts",
  "outputDirectory": "apps/frontend/dist",
  "installCommand": "bun install",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
