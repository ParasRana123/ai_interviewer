{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "cd apps/frontend && bun install && bun run build.ts",
  "outputDirectory": "apps/frontend/dist",
  "installCommand": "bun install",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/v1/:match*",
      "destination": "https://ai-interviewer-backend-xezj.onrender.com/api/v1/:match*"
    },
    {
      "source": "/api/:match*",
      "destination": "https://ai-interviewer-backend-xezj.onrender.com/api/:match*"
    },
    {
      "source": "/health",
      "destination": "https://ai-interviewer-backend-xezj.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
