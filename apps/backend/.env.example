# AI Technical Interviewer - Backend Environment Configuration

# 1. Google Gemini API Key (100% Free via https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. PostgreSQL Database Connection String (e.g., Neon / Supabase / Render Postgres)
# Example: postgresql://username:password@ep-cool-db.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# 3. Server Port (Render automatically sets this, defaults to 3001 locally)
PORT=3001

# 4. Frontend URL for CORS (e.g., your Vercel deployment URL)
FRONTEND_URL=https://your-frontend-app.vercel.app

# 5. Comma-separated list of allowed CORS origins
CORS_ORIGIN=https://your-frontend-app.vercel.app,http://localhost:3000

# 6. Environment
NODE_ENV=production
