{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bun run build.ts",
  "outputDirectory": "dist",
  "installCommand": "bun install",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/v1/:match*",
      "destination": "https://ai-interviewer-backend-xezj.onrender.com/api/v1/:match*"
    },
    {
      "source": "/api/:match*",
      "destination": "https://ai-interviewer-backend-xezj.onrender.com/api/:match*"
    },
    {
      "source": "/health",
      "destination": "https://ai-interviewer-backend-xezj.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|svg|png|jpg|jpeg|gif|webp|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
